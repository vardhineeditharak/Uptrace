# Uptrace - Cloud & Database Keep-Alive Monitor Configuration
# Security & Privacy Configuration Guide

# Flask Session Security Key (Generate a random string in production)
SECRET_KEY=uptrace-secret-key-change-in-production

# --- AUTHENTICATION & ACCESS CONTROL ---
# Set to 'true' to enforce login before accessing the SRE dashboard and API
REQUIRE_AUTH=true

# Master Administrator Password for quick direct login without OAuth
ADMIN_PASSWORD=admin123

# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: https://<your-deployed-domain>/login/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Private Whitelist: Comma-separated list of GitHub usernames allowed to log in
# Example: ALLOWED_GITHUB_USERS=myusername,devopslead
ALLOWED_GITHUB_USERS=

# Set to 'false' in production to disable 1-click demo login
ENABLE_DEMO_LOGIN=true

# --- EMAIL / SMTP INCIDENT ALERTS ---
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_SENDER_EMAIL=your-email@gmail.com
ALERT_RECEIVER_EMAIL=your-alerts-inbox@gmail.com

# --- WEBHOOK ALERTS (Optional) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# --- GITHUB 24/7 AUTOMATED STATUS & CONFIG SYNC ---
ENABLE_GIT_AUTO_COMMIT=false
GITHUB_TOKEN=
GITHUB_REPOSITORY=vardhineeditharak/Uptrace
GIT_COMMIT_AUTHOR_NAME=Uptrace Bot
GIT_COMMIT_AUTHOR_EMAIL=uptrace-bot@users.noreply.github.com

# Timezone Configuration (e.g. Asia/Kolkata, America/New_York, Europe/London, UTC)
TIMEZONE=Asia/Kolkata
TIMEZONE_CODE=IST

# Server Port
PORT=8000
