# ==============================================================================
# UPTRACE CONFIGURATION MATRIX: RENDER vs GITHUB SECRETS
# ==============================================================================
# This guide separates the exact variables needed for:
#   1. RENDER (24/7 Web Dashboard & Live Monitor Service)
#   2. GITHUB ACTIONS (Automated 12h Keep-Alive & Weekly Reports)
# ==============================================================================

# ==============================================================================
# 🌐 PART 1: RENDER ENVIRONMENT VARIABLES
# Add these in: Render Dashboard -> Your Service -> Environment tab
# ==============================================================================

# --- [RENDER] Session & Dashboard Security ---
SECRET_KEY=uptrace-super-secret-key-change-in-production
REQUIRE_AUTH=true
ADMIN_PASSWORD=admin123
ENABLE_DEMO_LOGIN=false

# --- [RENDER] GitHub OAuth 2.0 Login (Optional) ---
# Create an OAuth App at: https://github.com/settings/developers
# Callback URL: https://<your-render-app-name>.onrender.com/login/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USERS=your-github-username

# --- [RENDER] Email / SMTP Incident Alerts & Weekly Reports ---
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
ALERT_SENDER_EMAIL=your-email@gmail.com
ALERT_RECEIVER_EMAIL=your-alerts-inbox@gmail.com
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_RECIPIENT=your-alerts-inbox@gmail.com

# --- [RENDER] Optional Webhook Alerts ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# --- [RENDER] GitHub REST API Sync (Pushes config & status changes to repo) ---
ENABLE_GIT_AUTO_COMMIT=true
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_REPOSITORY=vardhineeditharak/Uptrace
GIT_COMMIT_AUTHOR_NAME=vardhineeditharak
GIT_COMMIT_AUTHOR_EMAIL=vardhineedi.tharak@gmail.com

# --- [RENDER] Timezone Configuration ---
TIMEZONE=Asia/Kolkata
TIMEZONE_CODE=IST
PORT=10000


# ==============================================================================
# 🤖 PART 2: GITHUB ACTIONS SECRETS
# Add these in: GitHub Repo -> Settings -> Secrets and variables -> Actions
# ==============================================================================
# The automated workflows (.github/workflows/uptrace-keepalive.yml and
# .github/workflows/uptrace-weekly-report.yml) use these secrets to ping services,
# dispatch immediate email alerts, and send weekly SRE reports headlessly.
#
# REQUIRED SECRETS:
# ------------------------------------------------------------------------------
# 1. SMTP_ENABLED             -> true
# 2. SMTP_HOST                -> smtp.gmail.com
# 3. SMTP_PORT                -> 587
# 4. SMTP_USER                -> your-email@gmail.com
# 5. SMTP_PASSWORD            -> your-16-character-gmail-app-password
# 6. ALERT_SENDER_EMAIL       -> your-email@gmail.com
# 7. ALERT_RECEIVER_EMAIL     -> your-alerts-inbox@gmail.com
#
# OPTIONAL SECRETS:
# ------------------------------------------------------------------------------
# 8. WEEKLY_REPORT_RECIPIENT  -> your-alerts-inbox@gmail.com (defaults to ALERT_RECEIVER_EMAIL)
# 9. GIT_AUTHOR_EMAIL         -> vardhineedi.tharak@gmail.com (for commit attribution)
# 10. DISCORD_WEBHOOK_URL     -> https://discord.com/api/webhooks/...
# 11. TELEGRAM_BOT_TOKEN      -> 123456789:ABCdef...
# 12. TELEGRAM_CHAT_ID        -> 987654321
# 13. SLACK_WEBHOOK_URL       -> https://hooks.slack.com/services/...
# ==============================================================================
