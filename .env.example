# ==============================================================================
# UPTRACE CONFIGURATION MATRIX: RENDER vs GITHUB SECRETS
# ==============================================================================
# This guide separates the exact variables needed for:
#   1. RENDER (24/7 Web Dashboard & Live Monitor Service)
#   2. GITHUB ACTIONS (Automated 12h Keep-Alive & Weekly Reports)
# ==============================================================================

# ==============================================================================
# 🌐 PART 1: RENDER ENVIRONMENT VARIABLES
# Add these in: Render Dashboard -> Your Service -> Environment tab
# ==============================================================================

# --- [RENDER] Session & Dashboard Security ---
SECRET_KEY=uptrace-super-secret-key-change-in-production
REQUIRE_AUTH=true
ADMIN_PASSWORD=admin123
ENABLE_DEMO_LOGIN=false

# --- [RENDER] GitHub OAuth 2.0 Login (Optional) ---
# Create an OAuth App at: https://github.com/settings/developers
# Callback URL: https://<your-render-app-name>.onrender.com/login/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USERS=your-github-username

# --- [RENDER] Email / Incident Alerts & Weekly Reports (Resend Recommended) ---
# Get free API key from: https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
SMTP_ENABLED=true
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_YOUR_RESEND_API_KEY
ALERT_SENDER_EMAIL=onboarding@resend.dev
ALERT_RECEIVER_EMAIL=your-alerts-inbox@gmail.com
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_RECIPIENT=your-alerts-inbox@gmail.com

# --- [RENDER] Optional Webhook Alerts ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# --- [RENDER] GitHub REST API Sync (Pushes config & status changes to repo) ---
ENABLE_GIT_AUTO_COMMIT=true
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_REPOSITORY=vardhineeditharak/Uptrace
GIT_COMMIT_AUTHOR_NAME=vardhineeditharak
GIT_COMMIT_AUTHOR_EMAIL=vardhineedi.tharak@gmail.com

# --- [RENDER] Timezone Configuration ---
TIMEZONE=Asia/Kolkata
TIMEZONE_CODE=IST
PORT=10000


# ==============================================================================
# 🤖 PART 2: GITHUB ACTIONS SECRETS
# Add these in: GitHub Repo -> Settings -> Secrets and variables -> Actions
# Or in bulk using: gh secret set -f secrets.env
# ==============================================================================
# The automated workflows (.github/workflows/uptrace-keepalive.yml and
# .github/workflows/uptrace-weekly-report.yml) use these secrets to ping services,
# dispatch immediate email alerts, and send weekly SRE reports headlessly.
#
# RECOMMENDED RESEND SECRETS (Free, 100% Reliable):
# ------------------------------------------------------------------------------
# 1. RESEND_API_KEY           -> re_... (from https://resend.com/api-keys)
# 2. SMTP_ENABLED             -> true
# 3. SMTP_HOST                -> smtp.resend.com
# 4. SMTP_PORT                -> 465
# 5. SMTP_USER                -> resend
# 6. SMTP_PASSWORD            -> re_... (same as RESEND_API_KEY)
# 7. ALERT_SENDER_EMAIL       -> onboarding@resend.dev
# 8. ALERT_RECEIVER_EMAIL     -> your-alerts-inbox@gmail.com
#
# OPTIONAL SECRETS:
# ------------------------------------------------------------------------------
# 9. WEEKLY_REPORT_RECIPIENT  -> your-alerts-inbox@gmail.com (defaults to ALERT_RECEIVER_EMAIL)
# 10. GIT_AUTHOR_EMAIL        -> vardhineedi.tharak@gmail.com (for commit attribution)
# 11. DISCORD_WEBHOOK_URL     -> https://discord.com/api/webhooks/...
# 12. TELEGRAM_BOT_TOKEN      -> 123456789:ABCdef...
# 13. TELEGRAM_CHAT_ID        -> 987654321
# 14. SLACK_WEBHOOK_URL       -> https://hooks.slack.com/services/...
# ==============================================================================
