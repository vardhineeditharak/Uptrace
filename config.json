{
  "project_name": "Uptrace",
  "version": "2.3.0",
  "settings": {
    "default_timeout_seconds": 6,
    "max_concurrent_workers": 8,
    "default_check_interval_seconds": 300,
    "incident_cooldown_minutes": 15
  },
  "services": [
    {
      "id": "prod-render-app",
      "name": "Production Web App (Render)",
      "environment": "production",
      "type": "http",
      "method": "GET",
      "url": "https://httpbin.org/status/200",
      "category": "Web Applications",
      "keep_alive_note": "Prevents Render 15-min free tier inactivity spin-down",
      "interval_seconds": 60,
      "expected_status": [200, 301, 302],
      "timeout": 8,
      "paused": false
    },
    {
      "id": "prod-vercel-frontend",
      "name": "Next.js Frontend (Vercel)",
      "environment": "production",
      "type": "http",
      "method": "HEAD",
      "url": "https://jsonplaceholder.typicode.com/posts/1",
      "category": "Web Applications",
      "keep_alive_note": "Monitors production edge deployment uptime via lightweight HEAD ping",
      "interval_seconds": 300,
      "expected_status": [200],
      "timeout": 5,
      "paused": false
    },
    {
      "id": "prod-api-graphql-post",
      "name": "GraphQL API Endpoint (POST)",
      "environment": "production",
      "type": "http",
      "method": "POST",
      "url": "https://httpbin.org/post",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"query\": \"{ health { status } }\"}",
      "category": "APIs & Microservices",
      "keep_alive_note": "POST payload health assertion for GraphQL gateway",
      "interval_seconds": 300,
      "expected_status": [200],
      "timeout": 6,
      "paused": false
    },
    {
      "id": "prod-supabase-db",
      "name": "Supabase PostgreSQL (Production)",
      "environment": "production",
      "type": "http",
      "method": "GET",
      "url": "https://httpbin.org/get?db=supabase_prod",
      "category": "Databases (Keep-Alive)",
      "keep_alive_note": "Prevents Supabase 7-day project pausing due to inactivity",
      "interval_seconds": 21600,
      "expected_status": [200],
      "timeout": 6,
      "paused": false
    },
    {
      "id": "prod-tcp-postgres",
      "name": "Production PostgreSQL Port (5432)",
      "environment": "production",
      "type": "tcp_db",
      "host": "one.one.one.one",
      "port": 53,
      "category": "Databases (Keep-Alive)",
      "keep_alive_note": "Direct socket handshake ping for Cloud Postgres DBs",
      "interval_seconds": 3600,
      "timeout": 5,
      "paused": false
    },
    {
      "id": "dev-local-api",
      "name": "Local Dev Backend (localhost:5000)",
      "environment": "development",
      "type": "http",
      "method": "GET",
      "url": "https://httpbin.org/get?env=development",
      "category": "Web Applications",
      "keep_alive_note": "Local development service health check",
      "interval_seconds": 120,
      "expected_status": [200],
      "timeout": 4,
      "paused": false
    },
    {
      "id": "dev-staging-db",
      "name": "Staging Redis Cache (TCP 6379)",
      "environment": "staging",
      "type": "tcp_db",
      "host": "dns.google",
      "port": 53,
      "category": "Databases (Keep-Alive)",
      "keep_alive_note": "Staging Redis instance connectivity",
      "interval_seconds": 900,
      "timeout": 5,
      "paused": false
    }
  ]
}